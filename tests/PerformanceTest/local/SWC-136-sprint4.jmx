          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Pick a prescription this thread owns" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import java.time.Instant

vars.put('dispenseId', 'NONE')
vars.put('dispenseQueueId', 'NONE')
if (prev.getResponseCode() != '200') {
    return
}

def counters = Math.max(1, (props.get('usersCounter') ?: '10').toInteger())
def mine = ctx.getThreadNum()
def cutoff = Instant.now().minusMillis((props.get('dispenseAfterMs') ?: '30000').toLong())

def pick = new JsonSlurper().parseText(prev.getResponseDataAsString()).find { p -&gt;
    p.status == 'PENDING' &amp;&amp;
        p.doctorName?.startsWith('Perf Clinic Doctor') &amp;&amp;
        Math.floorMod(p.id.hashCode(), counters) == mine &amp;&amp;
        Instant.parse(p.createdAt.endsWith('Z') ? p.createdAt : p.createdAt + 'Z').isBefore(cutoff)
}

if (pick) {
    vars.put('dispenseId', pick.id)
    vars.put('dispenseQueueId', pick.queueId)
}</stringProp>
          </JSR223PostProcessor>
