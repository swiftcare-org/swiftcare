        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Screen refresh" enabled="true">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">0</stringProp>
        </TestAction>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="~5s poll interval" enabled="true">
            <stringProp name="ConstantTimer.delay">${__P(pollDelay,4500)}</stringProp>
            <stringProp name="RandomTimer.range">${__P(pollRange,1000)}</stringProp>
          </UniformRandomTimer>
          <hashTree/>
        </hashTree>

        <!-- -JcounterQueuePoll=false isolates the Sprint 3 endpoints from the Sprint 2 queue poll. -->
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Counter polls the queue" enabled="true">
          <stringProp name="IfController.condition">${__P(counterQueuePoll,true)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/queue/today" enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
            <stringProp name="HTTPSampler.path">/api/queue/today</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="status is 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/prescriptions/pending" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.path">/api/prescriptions/pending</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="status is 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="body is a JSON array" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="0">(?s)^\[.*\]$</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Pending prescriptions is not a JSON array - possible contract regression.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">1</intProp>
          </ResponseAssertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="within read p99 budget" enabled="true">
            <stringProp name="DurationAssertion.duration">${__P(readSlaMs,2000)}</stringProp>
          </DurationAssertion>
          <hashTree/>
          <!-- Each receptionist thread owns the prescriptions whose id hashes to its thread number, so two
               threads never dispense the same one and a 409 means a real defect. Only this suite's doctors'
               prescriptions are picked, and only once the doctor has had time to finish editing them. -->
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Pick a prescription this thread owns" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import java.time.Instant

vars.put(&apos;dispenseId&apos;, &apos;NONE&apos;)
vars.put(&apos;dispenseQueueId&apos;, &apos;NONE&apos;)
if (prev.getResponseCode() != &apos;200&apos;) {
    return
}

def counters = Math.max(1, (props.get(&apos;usersClinicCounter&apos;) ?: &apos;1&apos;).toInteger())
def mine = ctx.getThreadNum()
def cutoff = Instant.now().minusMillis((props.get(&apos;dispenseAfterMs&apos;) ?: &apos;30000&apos;).toLong())

def pick = new JsonSlurper().parseText(prev.getResponseDataAsString()).find { p -&gt;
    p.status == &apos;PENDING&apos; &amp;&amp;
        p.doctorName?.startsWith(&apos;Perf Clinic Doctor&apos;) &amp;&amp;
        Math.floorMod(p.id.hashCode(), counters) == mine &amp;&amp;
        Instant.parse(p.createdAt.endsWith(&apos;Z&apos;) ? p.createdAt : p.createdAt + &apos;Z&apos;).isBefore(cutoff)
}

if (pick) {
    vars.put(&apos;dispenseId&apos;, pick.id)
    vars.put(&apos;dispenseQueueId&apos;, pick.queueId)
}</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>

        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="This thread owns a pending prescription" enabled="true">
          <stringProp name="IfController.condition">${__jexl3(&quot;${dispenseId}&quot; != &quot;NONE&quot;,)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Receptionist think time between steps" enabled="true">
            <stringProp name="ConstantTimer.delay">${__P(stepDelay,1000)}</stringProp>
            <stringProp name="RandomTimer.range">${__P(stepRange,2000)}</stringProp>
          </UniformRandomTimer>
          <hashTree/>

          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/prescriptions/queue/{queueId}" enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
            <stringProp name="HTTPSampler.path">/api/prescriptions/queue/${dispenseQueueId}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="status is 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="body is the picked PENDING prescription" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="0">${dispenseId}</stringProp>
                <stringProp name="1">&quot;PENDING&quot;</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">Counter view did not return the picked pending prescription.</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">16</intProp>
            </ResponseAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="within read p99 budget" enabled="true">
              <stringProp name="DurationAssertion.duration">${__P(readSlaMs,2000)}</stringProp>
            </DurationAssertion>
            <hashTree/>
          </hashTree>

          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="PUT /api/prescriptions/{id}/dispense" enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
            <stringProp name="HTTPSampler.path">/api/prescriptions/${dispenseId}/dispense</stringProp>
            <stringProp name="HTTPSampler.method">PUT</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="status is 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="body carries DISPENSED and dispensedBy" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="0">&quot;DISPENSED&quot;</stringProp>
                <stringProp name="1">&quot;dispensedBy&quot;</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">Dispensed prescription is missing an expected field - possible contract regression.</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">16</intProp>
            </ResponseAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="within write p99 budget" enabled="true">
              <stringProp name="DurationAssertion.duration">${__P(writeSlaMs,3500)}</stringProp>
            </DurationAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>

    </hashTree>
  </hashTree>
