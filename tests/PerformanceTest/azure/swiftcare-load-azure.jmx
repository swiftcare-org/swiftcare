        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Login (once per thread)" enabled="true"/>
        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="clinic-receptionists.csv" enabled="true">
            <stringProp name="filename">data/clinic-receptionists.csv</stringProp>
