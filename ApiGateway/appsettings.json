{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login-route": {
        "ClusterId": "auth-cluster",
        "Order": 1,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [ "POST" ]
        }
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Order": 2,
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "Order": 1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/users",
          "Methods": [ "GET", "POST" ]
        }
      },
      "patients-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/patients",
          "Methods": [ "POST" ]
        }
      },
      "patients-search-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "PatientSearchAndReadPolicy",
        "Match": {
          "Path": "/api/patients/search",
          "Methods": [ "GET" ]
        }
      },
      "patient-allergies-read-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "PatientSearchAndReadPolicy",
        "Match": {
          "Path": "/api/patients/{id:guid}/allergies",
          "Methods": [ "GET" ]
        }
      },
      "patient-allergies-write-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "AllergyWritePolicy",
        "Match": {
          "Path": "/api/patients/{id:guid}/allergies",
          "Methods": [ "POST" ]
        }
      },
      "patient-allergy-item-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "AllergyWritePolicy",
        "Match": {
          "Path": "/api/patients/{id:guid}/allergies/{aid:guid}",
          "Methods": [ "PUT", "DELETE" ]
        }
      },
      "patient-conditions-read-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "PatientSearchAndReadPolicy",
        "Match": {
          "Path": "/api/patients/{id:guid}/conditions",
          "Methods": [ "GET" ]
        }
      },
      "patient-conditions-create-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/patients/{id:guid}/conditions",
          "Methods": [ "POST" ]
        }
      },
      "patient-condition-delete-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/patients/{id:guid}/conditions/{conditionId:guid}",
          "Methods": [ "DELETE" ]
        }
      },
      "patient-read-route": {
        "ClusterId": "patient-cluster",
        "Order": 2,
        "AuthorizationPolicy": "PatientSearchAndReadPolicy",
        "Match": {
          "Path": "/api/patients/{id:guid}",
          "Methods": [ "GET" ]
        }
      },
      "patient-update-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/patients/{id:guid}",
          "Methods": [ "PUT" ]
        }
      },
      "patient-check-in-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/patients/{id:guid}/check-in",
          "Methods": [ "POST" ]
        }
      },
      "patient-queue-status-route": {
        "ClusterId": "queue-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/queue/today/patient/{patientId:guid}",
          "Methods": [ "GET" ]
        }
      },
      "today-queue-route": {
        "ClusterId": "queue-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/queue/today",
          "Methods": [ "GET" ]
        }
      },
      "waiting-pool-route": {
        "ClusterId": "queue-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/queue/today/waiting",
          "Methods": [ "GET" ]
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5000"
          }
        }
      },
      "patient-cluster": {
        "Destinations": {
          "patient-destination": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "queue-cluster": {
        "Destinations": {
          "queue-destination": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
