{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login-route": {
        "ClusterId": "auth-cluster",
        "Order": 1,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [ "POST" ]
        }
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Order": 2,
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "Order": 1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/users",
          "Methods": [ "GET", "POST" ]
        }
      },
      "patients-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/patients",
          "Methods": [ "POST" ]
        }
      },
      "patients-search-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "PatientSearchAndReadPolicy",
        "Match": {
          "Path": "/api/patients/search",
          "Methods": [ "GET" ]
        }
      },
      "patient-allergies-read-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "PatientSearchAndReadPolicy",
        "Match": {
          "Path": "/api/patients/{id:guid}/allergies",
          "Methods": [ "GET" ]
        }
      },
      "patient-allergies-write-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "AllergyWritePolicy",
        "Match": {
          "Path": "/api/patients/{id:guid}/allergies",
          "Methods": [ "POST" ]
        }
      },
      "patient-allergy-item-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "AllergyWritePolicy",
        "Match": {
          "Path": "/api/patients/{id:guid}/allergies/{aid:guid}",
          "Methods": [ "PUT", "DELETE" ]
        }
      },
      "patient-conditions-read-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "PatientSearchAndReadPolicy",
        "Match": {
          "Path": "/api/patients/{id:guid}/conditions",
          "Methods": [ "GET" ]
        }
      },
      "patient-conditions-create-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/patients/{id:guid}/conditions",
          "Methods": [ "POST" ]
        }
      },
      "patient-condition-delete-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/patients/{id:guid}/conditions/{conditionId:guid}",
          "Methods": [ "DELETE" ]
        }
      },
      "patient-read-route": {
        "ClusterId": "patient-cluster",
        "Order": 2,
        "AuthorizationPolicy": "PatientSearchAndReadPolicy",
        "Match": {
          "Path": "/api/patients/{id:guid}",
          "Methods": [ "GET" ]
        }
      },
      "patient-update-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/patients/{id:guid}",
          "Methods": [ "PUT" ]
        }
      },
      "patient-check-in-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/patients/{id:guid}/check-in",
          "Methods": [ "POST" ]
        }
      },
      "patient-queue-status-route": {
        "ClusterId": "queue-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/queue/today/patient/{patientId:guid}",
          "Methods": [ "GET" ]
        }
      },
      "call-next-route": {
        "ClusterId": "queue-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/queue/call-next",
          "Methods": [ "PUT" ]
        }
      },
      "waiting-room-display-route": {
        "ClusterId": "queue-cluster",
        "Order": 1,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/queue/display",
          "Methods": [ "GET" ]
        }
      },
      "today-queue-route": {
        "ClusterId": "queue-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/queue/today",
          "Methods": [ "GET" ]
        }
      },
      "waiting-pool-route": {
        "ClusterId": "queue-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/queue/today/waiting",
          "Methods": [ "GET" ]
        }
      },
      "current-patient-route": {
        "ClusterId": "queue-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/queue/today/current",
          "Methods": [ "GET" ]
        }
      },
      "prescriptions-create-route": {
        "ClusterId": "prescription-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/prescriptions",
          "Methods": [ "POST" ]
        }
      },
      "prescription-by-queue-route": {
        "ClusterId": "prescription-cluster",
        "Order": 1,
        "AuthorizationPolicy": "PrescriptionReadPolicy",
        "Match": {
          "Path": "/api/prescriptions/queue/{queueId:guid}",
          "Methods": [ "GET" ]
        }
      },
      "prescription-dispense-route": {
        "ClusterId": "prescription-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOnly",
        "Match": {
          "Path": "/api/prescriptions/{prescriptionId:guid}/dispense",
          "Methods": [ "PUT" ]
        }
      },
      "prescription-items-add-route": {
        "ClusterId": "prescription-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/prescriptions/{prescriptionId:guid}/items",
          "Methods": [ "POST" ]
        }
      },
      "prescription-items-remove-route": {
        "ClusterId": "prescription-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/prescriptions/{prescriptionId:guid}/items/{medicineId:guid}",
          "Methods": [ "DELETE" ]
        }
      },
      "prescription-history-route": {
        "ClusterId": "prescription-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/prescriptions/patient/{patientId:guid}",
          "Methods": [ "GET" ]
        }
      },
      "consultations-create-route": {
        "ClusterId": "medical-record-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/consultations",
          "Methods": [ "POST" ]
        }
      },
      "consultation-vital-signs-create-route": {
        "ClusterId": "medical-record-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/consultations/{consultationId:guid}/vitals",
          "Methods": [ "POST" ]
        }
      },
      "consultation-complete-route": {
        "ClusterId": "medical-record-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/consultations/{consultationId:guid}/complete",
          "Methods": [ "POST" ]
        }
      },
      "consultation-by-queue-route": {
        "ClusterId": "medical-record-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/consultations/by-queue/{queueId:guid}",
          "Methods": [ "GET" ]
        }
      },
      "consultation-latest-completed-route": {
        "ClusterId": "medical-record-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/consultations/latest-completed",
          "Methods": [ "GET" ]
        }
      },
      "consultation-latest-follow-up-route": {
        "ClusterId": "medical-record-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/consultations/patient/{patientId:guid}/latest-follow-up",
          "Methods": [ "GET" ]
        }
      },
      "consultation-templates-route": {
        "ClusterId": "medical-record-cluster",
        "Order": 1,
        "AuthorizationPolicy": "DoctorOnly",
        "Match": {
          "Path": "/api/templates",
          "Methods": [ "GET" ]
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5000"
          }
        }
      },
      "patient-cluster": {
        "Destinations": {
          "patient-destination": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "queue-cluster": {
        "Destinations": {
          "queue-destination": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "medical-record-cluster": {
        "Destinations": {
          "medical-record-destination": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "prescription-cluster": {
        "Destinations": {
          "prescription-destination": {
            "Address": "http://localhost:5001"
          }
        }
      }
    }
  }
}
