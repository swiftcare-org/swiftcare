{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login-route": {
        "ClusterId": "auth-cluster",
        "Order": 1,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [ "POST" ]
        }
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Order": 2,
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "Order": 1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/users",
          "Methods": [ "GET", "POST" ]
        }
      },
      "patients-route": {
        "ClusterId": "patient-cluster",
        "Order": 1,
        "AuthorizationPolicy": "ReceptionistOrAdmin",
        "Match": {
          "Path": "/api/patients",
          "Methods": [ "POST" ]
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5000"
          }
        }
      },
      "patient-cluster": {
        "Destinations": {
          "patient-destination": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}
