# Production state in the production subscription. Copy to backend-production.hcl (ignored) and
# set the real IDs. Storage account names are global; the previous subscription still holds
# swiftcaretfstate, so this backend uses its own account.
resource_group_name  = "swiftcare-tfstate-rg"
storage_account_name = "swiftcaretfstatesea"
container_name       = "tfstate"
key                  = "azure-production.tfstate"
subscription_id      = "00000000-0000-0000-0000-000000000000"
tenant_id            = "00000000-0000-0000-0000-000000000000"
use_azuread_auth     = true
